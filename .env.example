# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key

# Dedicated least-privilege PostgreSQL login used by workers and webhooks.
# Never substitute a Supabase service-role JWT for this connection.
DRAINLY_SYSTEM_DATABASE_URL=postgresql://drainly_system:replace-me@127.0.0.1:54322/postgres

# Core marketplace, authentication, and notifications are independent.
PROVIDER_MODE=fake
AUTH_PROVIDER_MODE=fake
NOTIFICATION_PROVIDER_MODE=fake
# Independent payment adapter. "stripe_test" is accepted; live Stripe keys are rejected.
PAYMENT_PROVIDER_MODE=fake
# Transactional marketplace pilot is closed by default. "sandbox" still uses Stripe test mode only.
PILOT_MODE=off
# Comma-separated, verified customer emails allowed to create sandbox pilot bookings.
PILOT_ALLOWED_EMAILS=
OUTBOUND_PROVIDER_TIMEOUT_MS=40000
# Fake-only deterministic notification behavior: success, failure, or timeout.
FAKE_NOTIFICATION_BEHAVIOR=success
APP_BASE_URL=http://127.0.0.1:3000
CRON_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters

# Stripe test mode only during implementation
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional real adapters; leave unset in fake mode
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Drainly <bookings@example.invalid>
OPS_ALERT_EMAIL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
